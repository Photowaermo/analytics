# API Configuration
NEXT_PUBLIC_API_URL=https://leads.photowaermo.de/analytics

# Authentication (REQUIRED in production)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-min-32-characters-here
AUTH_PASSWORD=your-secure-password

# Zweiter Zugang: nur der Schnellanruf-Tab (30-Minuten-System)
AUTH_PASSWORD_SPEED_DIAL=your-speed-dial-password
